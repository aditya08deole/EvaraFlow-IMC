# Templated by nginx's own built-in envsubst mechanism (nginx:alpine has
# supported this since 1.19 -- any file placed at /etc/nginx/templates/*.template
# gets envsubst run on it automatically at container start, writing the
# result to /etc/nginx/conf.d/, before nginx itself starts). ${PORT} is
# the host platform's (Railway/Render) externally-assigned port for this
# service, set as a real env var at container start, so this can't be
# hardcoded.
#
# No `:-8080` bash-style default here on purpose -- confirmed by direct
# testing that `envsubst` does NOT understand that syntax at all (it only
# recognizes a bare `${VARNAME}`); `${PORT:-8080}` survived completely
# unsubstituted and nginx failed to start with "invalid port in
# ${PORT:-8080}" even with PORT genuinely set in the environment. The
# fallback value lives in the Dockerfile instead, as a plain `ENV
# PORT=8080` -- Docker ENV defaults are themselves overridden by whatever
# PORT the platform injects at container start, so the net behavior is
# the same, just expressed somewhere envsubst can't misparse it.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Everything the backend (server/src/index.ts) actually exposes --
    # webhooks (ingest), the admin backfill trigger, and the two image
    # proxies -- forwarded to the Node process running in this same
    # container on its fixed internal port (never Railway's $PORT; see
    # railway-start-backend.sh). Same-origin means the frontend's
    # admin-backfill call and the Firestore-stored image proxy URLs all
    # just work with no CORS and no separate domain to configure.
    location /health {
        proxy_pass http://127.0.0.1:3000/health;
    }

    location /ingest/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location /tailscale-images/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location /drive-images/ {
        proxy_pass http://127.0.0.1:3000;
    }

    # Flutter web's own client-side routing -- unknown paths fall back to
    # index.html rather than a raw nginx 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|wasm|json)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
