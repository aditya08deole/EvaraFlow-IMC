{
  "name": "evaraflow-server",
  "description": "EvaraFlow backend — MQTT telemetry and Google Drive image ingestion. Deployed on Railway as a standalone Node/Express service; Firestore/Storage remain on Firebase, reached via a service-account key (see README.md in this directory).",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsc && node --test \"dist/__tests__/**/*.test.js\"",
    "seed:device": "node dist/scripts/seedDevice.js",
    "check:device": "node dist/scripts/checkDevice.js",
    "claims:set": "node dist/scripts/setUserClaims.js",
    "backfill:drive": "node dist/scripts/backfillDriveImages.js",
    "prune:drive": "node dist/scripts/pruneDeletedDriveImages.js"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.6.0",
    "google-auth-library": "^9.15.1",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  }
}
