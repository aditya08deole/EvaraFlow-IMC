# Copy to .env for local dev only. In Railway, set these as real
# environment variables in the service's Variables tab — never commit
# actual values, and never paste the service-account JSON into chat,
# a file tracked by git, or anywhere outside Railway's Variables UI.

PORT=8080

# Base64-encoded contents of a Firebase service-account JSON key
# (Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key). Base64 avoids newline-escaping issues with the
# private_key field when pasted into Railway's variable editor:
#   certutil -encode key.json tmp.b64 && find /v "-" tmp.b64 > key.b64   (Windows)
#   base64 -w0 key.json                                                  (macOS/Linux)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Shared secrets this service checks against the X-Webhook-Secret header
# on incoming requests. Generate with: openssl rand -hex 32
EMQX_WEBHOOK_SECRET=
DRIVE_WEBHOOK_SECRET=

# Optional: when set, this service connects directly to the MQTT broker as
# a subscriber and feeds messages through the same validation/ingest path
# as /ingest/telemetry, instead of relying on an EMQX Rule Engine webhook
# being configured on the broker side. Leave unset to disable the bridge
# and rely on the HTTP webhook only.
MQTT_HOST=mqtt.evaratech.com
# wss (default) connects over MQTT-over-WebSocket-Secure, effectively port
# 443 — confirmed to get through networks that block raw MQTT/1883
# outright. Set to "mqtt" only if you've confirmed outbound 1883 actually
# works wherever this runs (e.g. some cloud hosts have no such
# restriction) and would rather skip the WebSocket framing overhead.
MQTT_PROTOCOL=wss
# MQTT_PORT: defaults to 443 for wss, 1883 for mqtt — only set this if the
# broker uses a non-default port for whichever protocol you picked.
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_FILTER=evaratech/v1/+/telemetry
